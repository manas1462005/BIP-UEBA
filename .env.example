# Monorepo Environment Variables Example

# Environment Mode
NODE_ENV=development
ENVIRONMENT=development

# Backend Settings
BACKEND_PORT=8000
SECRET_KEY=super-secret-key-change-this-in-production-min-32-chars-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]

# Database Settings
POSTGRES_USER=bip_admin
POSTGRES_PASSWORD=bip_password_secure
POSTGRES_DB=bip_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://bip_admin:bip_password_secure@localhost:5432/bip_db

# Frontend Settings
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_TITLE="Behavioral Intelligence Platform"
